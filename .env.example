# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN VƯỜN LỜI CHÚC 20/10 (MẪU)
# ==============================================================================

# 1. Supabase configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
# Server-only: never prefix this key with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# 2. Mật khẩu mở Hành trình riêng (Private Journey)
PRIVATE_JOURNEY_PASSCODE=replace_with_a_unique_passcode

# 3. Mật khẩu Quản trị viên (Admin Dashboard)
ADMIN_PASSWORD=replace_with_a_unique_admin_password
# Server-only HMAC-SHA-256 signing key; use at least 32 random bytes.
ADMIN_TOKEN_SECRET=replace_with_at_least_32_random_bytes
